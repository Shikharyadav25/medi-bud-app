ENVIRONMENT=development
PORT=8000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Only needed for legacy HS256 projects. Asymmetric projects use JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Server only: identity deletion. Never place this in web/mobile environments.
SUPABASE_SERVICE_ROLE_KEY=
# Local development uses SQLite. Production requires PostgreSQL with TLS.
DATABASE_URL=sqlite:///./medibud.sqlite3
# Required in production: a Fernet key, generated locally (see docs/production.md).
DATA_ENCRYPTION_KEY=
# Required only for photo/scanned report extraction and meal analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_DEMO_AUTH=false
ENABLE_LOCAL_EMBEDDINGS=false
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
MAX_REPORTS_PER_USER=100
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3001"]
