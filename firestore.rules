rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasFamilyPermission(userId, permissionKey) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(userId)/family/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(userId)/family/$(request.auth.uid)).data.permissions[permissionKey] == true;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId) || hasFamilyPermission(userId, 'profile');
      allow write: if isOwner(userId);
      
      // Daily Vitals
      match /vitals/{vitalId} {
        allow read: if isOwner(userId) || hasFamilyPermission(userId, 'vitals');
        allow write: if isOwner(userId);
      }
      
      // Water Intake
      match /water/{entryId} {
        allow read: if isOwner(userId) || hasFamilyPermission(userId, 'vitals');
        allow write: if isOwner(userId);
      }
      
      // Meals & Nutrition
      match /meals/{mealId} {
        allow read: if isOwner(userId) || hasFamilyPermission(userId, 'plans');
        allow write: if isOwner(userId);
      }
      
      // Workouts
      match /workouts/{workoutId} {
        allow read: if isOwner(userId) || hasFamilyPermission(userId, 'plans');
        allow write: if isOwner(userId);
      }
      
      // Sleep Tracking
      match /sleep/{sleepId} {
        allow read: if isOwner(userId) || hasFamilyPermission(userId, 'vitals');
        allow write: if isOwner(userId);
      }
      
      // Mood / Mental Wellness
      match /mood/{moodId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
      
      // Medical Reports
      match /reports/{reportId} {
        allow read: if isOwner(userId) || hasFamilyPermission(userId, 'reports');
        allow write: if isOwner(userId);
      }
      
      // Medications
      match /medications/{medicationId} {
        allow read: if isOwner(userId) || hasFamilyPermission(userId, 'medications');
        allow write: if isOwner(userId);
      }
      
      // Personalized Diet & Workout Plans
      match /plans/{planId} {
        allow read: if isOwner(userId) || hasFamilyPermission(userId, 'plans');
        allow write: if isOwner(userId);
      }
      
      // Family Members & Permission Grants
      match /family/{memberId} {
        allow read: if isOwner(userId) || request.auth.uid == memberId;
        allow write: if isOwner(userId);
      }
      
      // AI Conversations & Messages
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);
        
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Public & Moderated Wellness Communities
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin/server-managed
      
      match /posts/{postId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
        
        match /comments/{commentId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
          allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
        }
      }
    }
  }
}
