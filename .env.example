# ==============================================================================
# MEDI BUD - ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: SENSITIVE KEYS (LIKE GEMINI_API_KEY) MUST ONLY BE SET IN backend/.env.
# NEVER EXPOSE GEMINI API KEYS IN THE MOBILE CLIENT!

# Backend API Base URL (For physical device testing, use your machine's LAN IP e.g. http://192.168.1.50:5001)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Put these only in services/api/.env, never expose them with an EXPO_PUBLIC_ prefix.
GEMINI_API_KEY=replace_with_server_side_key
GEMINI_MODEL=gemini-3.8-flash

# Firebase Client Configuration (From Firebase Console > Project Settings > General)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDemoDummyKeyForMobileClient12345
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=medi-bud-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=medi-bud-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=medi-bud-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Default Environment Mode ('development' | 'production')
EXPO_PUBLIC_APP_ENV=development
